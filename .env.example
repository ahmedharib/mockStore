# Database configuration (defaults used by docker-compose)
PGDATABASE=postgres
PGUSER=app_user
PGPASSWORD=app_secret
PGHOST=localhost
PGPORT=5432

# Aegis Autonomous SRE Webhook endpoint
# Local daemon listener:
AEGIS_WEBHOOK_URL="http://localhost:8080/webhooks/alert"
# Modal cloud serverless endpoint:
# AEGIS_WEBHOOK_URL="https://<workspace>--aegis-sre-daemon-webhook-daemon.modal.run/webhooks/alert"
